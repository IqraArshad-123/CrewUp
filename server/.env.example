MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/crewup
JWT_SECRET=replace-with-at-least-32-random-characters
API_PORT=4100
API_URL=http://127.0.0.1:4100
APP_URL=http://localhost:3000
NODE_ENV=development
API_HOST=127.0.0.1
MAIL_MODE=local
MAIL_DIR=.data/mail
# Production: MAIL_MODE=smtp; verified sender and SMTP credentials required.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hello@example.com
FILE_STORAGE=s3
PRIVATE_FILES_DIR=.data/private
# Optional private S3-compatible storage; requires bucket CORS for the app origin.
# FILE_STORAGE=s3
# S3_BUCKET=crewup-private
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Required in production; local demo can use polling without Redis.
# REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=crewup
TRUST_PROXY_HOPS=0
